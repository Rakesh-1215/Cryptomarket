{
  "name": "cryptomarket",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm run dev:all",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "seed": "npm --prefix backend run seed",
    "view-db": "npm --prefix backend run view-db",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "server": "npm --prefix backend start",
    "test": "npm --prefix backend test",
    "ml:install": "npm --prefix backend run ml:install",
    "ml:predict": "npm --prefix backend run ml:predict",
    "ml:portfolio": "npm --prefix backend run ml:portfolio"
  },
  "keywords": [],
